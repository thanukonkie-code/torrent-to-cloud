import json
from pathlib import Path

import msal
import requests

from .config import TOKENS_PATH, ensure_paths, get_client_config


class OneDriveClient:
    def __init__(self, client_id: str | None = None, tenant_id: str | None = None):
        ensure_paths()
        config = get_client_config()
        self.client_id = client_id or config["client_id"]
        self.tenant_id = tenant_id or config["tenant_id"]
        self.tokens_path = TOKENS_PATH

    def login(self) -> dict:
        if not self.client_id:
            raise ValueError("MICROSOFT_CLIENT_ID is not set. Add it to your environment or .env file.")

        app = msal.PublicClientApplication(
            self.client_id,
            authority=f"https://login.microsoftonline.com/{self.tenant_id}",
        )
        flow = app.initiate_device_flow(scopes=["Files.ReadWrite.All", "User.Read"])
        if "user_code" not in flow:
            raise RuntimeError(f"Could not initiate device flow: {flow}")

        print(flow["message"])
        result = app.acquire_token_by_device_flow(flow)
        if "access_token" not in result:
            raise RuntimeError(f"Login failed: {result}")

        with self.tokens_path.open("w", encoding="utf-8") as handle:
            json.dump(result, handle, indent=2, sort_keys=True)
        return result

    def _get_access_token(self) -> str:
        if self.tokens_path.exists():
            try:
                with self.tokens_path.open("r", encoding="utf-8") as handle:
                    token_data = json.load(handle)
                if token_data.get("access_token"):
                    return token_data["access_token"]
            except json.JSONDecodeError:
                pass
        result = self.login()
        return result["access_token"]

    def upload_file(self, source_path: str, folder: str | None = None) -> dict:
        path = Path(source_path).expanduser()
        if not path.exists():
            raise FileNotFoundError(f"File not found: {source_path}")

        token = self._get_access_token()
        file_name = path.name
        destination = file_name
        if folder:
            destination = f"{folder.strip('/')}/{file_name}"

        upload_url = f"https://graph.microsoft.com/v1.0/me/drive/root:/{destination.replace(' ', '%20')}:/content"
        with path.open("rb") as handle:
            response = requests.put(upload_url, headers={"Authorization": f"Bearer {token}"}, data=handle)
        if response.status_code in {200, 201}:
            return response.json()
        if response.status_code == 404 and folder:
            folder_id = self.create_folder(folder)
            if folder_id:
                parent_url = f"https://graph.microsoft.com/v1.0/me/drive/items/{folder_id}:/{file_name}:/content"
                with path.open("rb") as handle:
                    response = requests.put(parent_url, headers={"Authorization": f"Bearer {token}"}, data=handle)
                if response.status_code in {200, 201}:
                    return response.json()
        response.raise_for_status()
        raise RuntimeError(f"OneDrive upload failed: {response.status_code} {response.text}")

    def create_folder(self, folder_name: str) -> str:
        token = self._get_access_token()
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
        payload = {"name": folder_name, "folder": {}}
        response = requests.post("https://graph.microsoft.com/v1.0/me/drive/root/children", headers=headers, json=payload)
        if response.status_code in {200, 201}:
            return response.json()["id"]
        if response.status_code == 409:
            existing = requests.get(
                f"https://graph.microsoft.com/v1.0/me/drive/root/children?$filter=name eq '{folder_name}'",
                headers=headers,
            )
            if existing.status_code == 200 and existing.json().get("value"):
                return existing.json()["value"][0]["id"]
        response.raise_for_status()
        raise RuntimeError("Unable to create OneDrive folder")
